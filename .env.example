VITE_FIREBASE_API_KEY=tu_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Culqi - Pasarela de Pagos
# Pública: se expone al navegador (prefijo VITE_).
VITE_CULQI_PUBLIC_KEY=tu_llave_publica_aqui
# Secreta: SOLO servidor, sin prefijo VITE_. La consume api/culqi-charge.js.
# En producción se configura como Environment Variable en Vercel, no en el repo.
CULQI_SECRET_KEY=tu_llave_secreta_aqui

# Cloudinary - Subida de imágenes (unsigned upload, seguro en cliente).
# Crear preset Unsigned: Cloudinary → Settings → Upload → Upload presets → Add.
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset_unsigned
